#!/usr/bin/env bash
# git-wt: one place for every git worktree, whoever creates it.
#
#   $WORKTREE_ROOT/<repo>/<name>      (default WORKTREE_ROOT=$HOME/Development/worktrees)
#
# Humans and coding agents (Claude Code, Codex, Cursor, Gemini, OpenCode, ...) should
# create worktrees with `git wt add`, never `git worktree add <arbitrary path>`.
# Claude Code is wired to it through WorktreeCreate/WorktreeRemove hooks
# (`git wt claude-hook create|remove`), which also covers subagent worktrees.
#
# Usage:
#   git wt add [-C <dir>] [-b <branch>] [--base <ref> | --from-head] <name>
#                                    create; prints the new path on stdout (nothing else)
#   git wt rm <path|name>            remove the worktree (branch is kept)
#   git wt path <name>               print where <name> would live for this repo
#   git wt ls                        list this repo's worktrees
#   git wt doctor [<dir>...]         list worktrees outside the convention
#                                    (scans $WORKTREE_SCAN_DIRS, default ~/Development/Github)
#   git wt root                      print $WORKTREE_ROOT
#   git wt setup [<dir>]             remove the old shared cargo build-dir config for this repo
#   git wt seed [<path|name>]        give an existing worktree a fresh copy of the main
#                                    checkout's target/ (replaces the worktree's target/)
#   git wt prune [--dry-run] [<dir>] delete agent branches (claude/ codex/ wt/ worktree-*; set
#                                    WORKTREE_PRUNE_PATTERNS) whose work has provably landed:
#                                    merged into origin's default branch, tip == a merged PR's
#                                    head (gh), or every commit already upstream. Branches
#                                    checked out in any worktree are never touched.
#   git wt claude-hook create|remove (stdin: Claude Code hook JSON)
#
# Defaults: new branch wt/<name> (claude/<name> from the Claude hook, prefix via
# WORKTREE_BRANCH_PREFIX), based on a freshly fetched origin/<default-branch>, else HEAD.
# Gitignored files matching the repo's .worktreeinclude are copied in (Claude skips
# .worktreeinclude when a WorktreeCreate hook is set, so this replaces it).
# Rust repos: a new worktree's target/ starts as a copy-on-write clone (APFS clonefile) of
# the main checkout's target/, so compiled dependencies, proc-macros and build scripts are
# reused and only the workspace's own crates rebuild. The clone costs no disk until either
# side changes. Each worktree then owns its target/: no shared lock, no cross-branch reuse.
# Set WORKTREE_CARGO_SEED=0 to skip it.
set -euo pipefail

ROOT="${WORKTREE_ROOT:-$HOME/Development/worktrees}"

log() { printf 'git-wt: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }

# Absolute path of the main checkout of the repo that contains $1.
main_repo() {
    local common
    common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
        die "not inside a git repository: $1"
    if [ "$(basename "$common")" = ".git" ]; then
        dirname "$common"
    else
        printf '%s\n' "$common" # bare repository
    fi
}

repo_name() {
    local n
    n=$(basename "$1")
    printf '%s\n' "${n%.git}"
}

sanitize() {
    local n
    n=$(printf '%s' "$1" | tr '/ :' '---' | tr -cd 'A-Za-z0-9._-')
    case "$n" in "" | . | ..) die "invalid worktree name: '$1'" ;; esac
    printf '%s\n' "$n"
}

# origin/<default-branch>, fetched (non-interactive, short timeout); falls back to HEAD.
default_base() {
    local repo=$1 def
    def=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || {
        printf 'HEAD\n'
        return
    }
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes -o ConnectTimeout=5" \
        git -C "$repo" fetch --quiet origin "${def#origin/}" >&2 2>/dev/null ||
        log "fetch of $def failed; using the local copy"
    printf '%s\n' "$def"
}

copy_includes() {
    local repo=$1 dest=$2 f n=0
    [ -f "$repo/.worktreeinclude" ] || return 0
    while IFS= read -r -d '' f; do
        mkdir -p "$dest/$(dirname "$f")"
        cp -p "$repo/$f" "$dest/$f"
        n=$((n + 1))
    done < <(git -C "$repo" ls-files -z --others --ignored --exclude-from="$repo/.worktreeinclude" |
        git -C "$repo" check-ignore -z --stdin --no-index 2>/dev/null || true)
    [ "$n" -eq 0 ] || log "copied $n file(s) from .worktreeinclude"
}

# Older git-wt pointed every worktree's cargo build-dir at the main checkout's target/.
# Don't: cargo gives a workspace crate the same artifact slot in every checkout, so one
# branch's build is reused as "fresh" by another checkout whose files are older.
CARGO_MARKER="# managed by git-wt (shared cargo build-dir)"
remove_shared_build_dir() {
    local cfg="$ROOT/$(repo_name "$1")/.cargo/config.toml"
    [ -f "$cfg" ] && grep -qF "$CARGO_MARKER" "$cfg" || return 0
    rm -f "$cfg"
    rmdir "$(dirname "$cfg")" 2>/dev/null || true
    log "removed shared cargo build-dir config: $cfg"
}

# Clone <repo>/target to <dest> (which must not exist). Fails quietly off APFS.
clone_target() {
    local repo=$1 dest=$2
    [ "${WORKTREE_CARGO_SEED:-1}" != 0 ] && [ -f "$repo/Cargo.toml" ] && [ -d "$repo/target" ] || return 1
    if cp -c -R -p "$repo/target" "$dest" 2>/dev/null; then
        return 0
    fi
    rm -rf "$dest"
    log "could not clone $repo/target (not APFS?); the first build starts from scratch"
    return 1
}

# Seed a new worktree. The clone is taken BEFORE the checkout, so every artifact in it is
# older than every checked-out file: cargo rebuilds the workspace's crates once and can
# never mistake the main checkout's build for this branch's.
stage_target() { # stage_target <repo> <path>: prints the staging dir, or nothing
    local stage
    stage="$(dirname "$2")/.seed-$(basename "$2")"
    rm -rf "$stage"
    clone_target "$1" "$stage" && printf '%s\n' "$stage"
}
place_target() { # place_target <stage> <path>
    [ -n "$1" ] || return 0
    if [ -e "$2/target" ]; then
        rm -rf "$1"
    else
        mv "$1" "$2/target"
        log "seeded target/ from the main checkout"
    fi
}

cmd_add() {
    local dir=. branch='' base='' name
    while [ $# -gt 0 ]; do
        case "$1" in
        -C) dir=$2; shift 2 ;;
        -b) branch=$2; shift 2 ;;
        --base) base=$2; shift 2 ;;
        --from-head) base=HEAD; shift ;;
        -h | --help) awk 'NR>1 && /^set -euo/{exit} NR>1' "$0" >&2; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *) break ;;
        esac
    done
    [ $# -eq 1 ] || die "usage: git wt add [-C dir] [-b branch] [--base ref|--from-head] <name>"
    name=$(sanitize "$1")

    local repo path
    repo=$(main_repo "$dir")
    path="$ROOT/$(repo_name "$repo")/$name"
    [ ! -e "$path" ] || die "already exists: $path"
    branch=${branch:-${WORKTREE_BRANCH_PREFIX:-wt}/$name}

    mkdir -p "$(dirname "$path")"
    local existing=0 stage
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
        existing=1
    else
        [ -n "$base" ] || base=$(default_base "$repo")
    fi
    stage=$(stage_target "$repo" "$path") || stage=''
    if [ "$existing" -eq 1 ]; then
        git -C "$repo" worktree add "$path" "$branch" >&2 || { rm -rf "$stage"; exit 1; }
    else
        git -C "$repo" worktree add -b "$branch" "$path" "$base" >&2 || { rm -rf "$stage"; exit 1; }
    fi
    place_target "$stage" "$path"
    copy_includes "$repo" "$path"
    remove_shared_build_dir "$repo"
    printf '%s\n' "$path"
}

cmd_setup() { # clean up per-repo files from older git-wt versions (default: repo of .)
    local repo
    repo=$(main_repo "${1:-.}")
    remove_shared_build_dir "$repo"
    log "set up $(repo_name "$repo")"
}

# Re-seed an existing worktree. Its files may be older than the main checkout's artifacts,
# so every tracked file is touched afterwards: the workspace's crates rebuild once instead
# of cargo trusting the main checkout's build of them.
cmd_seed() {
    local path=${1:-.} repo stage
    if [ ! -d "$path" ] && [ "${path#/}" = "$path" ]; then
        path="$ROOT/$(repo_name "$(main_repo .)")/$(sanitize "$path")"
    fi
    [ -d "$path" ] || die "no such worktree: $path"
    path=$(git -C "$path" rev-parse --show-toplevel)
    repo=$(main_repo "$path")
    [ "$(cd "$path" && pwd -P)" != "$(cd "$repo" && pwd -P)" ] || die "that is the main checkout: $path"
    stage="$(dirname "$path")/.seed-$(basename "$path")"
    rm -rf "$stage"
    clone_target "$repo" "$stage" || die "nothing to seed from: $repo/target"
    rm -rf "$path/target"
    mv "$stage" "$path/target"
    (cd "$path" && git ls-files -z | xargs -0 touch -c)
    log "seeded $path/target from $repo/target"
}

cmd_rm() {
    [ $# -eq 1 ] || die "usage: git wt rm <path|name>"
    local path=$1 repo
    if [ ! -d "$path" ] && [ "${path#/}" = "$path" ]; then
        repo=$(main_repo .)
        path="$ROOT/$(repo_name "$repo")/$(sanitize "$path")"
    fi
    if [ ! -d "$path" ]; then
        log "already gone: $path"
        exit 0
    fi
    path=$(cd "$path" && pwd -P)
    repo=$(main_repo "$path")
    [ "$path" != "$(cd "$repo" && pwd -P)" ] || die "refusing to remove the main checkout: $path"

    if ! git -C "$repo" worktree remove --force "$path" >&2; then
        case "$path" in
        "$ROOT"/*) rm -rf "$path"; git -C "$repo" worktree prune >&2 ;;
        *) die "git worktree remove failed for $path" ;;
        esac
    fi
    rmdir "$(dirname "$path")" 2>/dev/null || true
    log "removed $path (branch kept)"
}

cmd_ls() { git -C "$(main_repo .)" worktree list; }

cmd_doctor() {
    local dirs=("$@") d g repo out=
    [ ${#dirs[@]} -gt 0 ] || read -r -a dirs <<<"${WORKTREE_SCAN_DIRS:-$HOME/Development/Github}"
    for d in "${dirs[@]}"; do
        for g in "$d"/*/.git; do
            [ -d "$g" ] || continue
            repo=$(dirname "$g")
            out+=$(git -C "$repo" worktree list --porcelain | awk -v r="$repo" -v root="$ROOT/" '
                /^worktree /{p=substr($0,10)} /^prunable/{pr=1}
                /^$/{ if (p!=r && index(p,root)!=1) print (pr?"[prunable] ":"") r " -> " p; p=""; pr=0 }')
            out+=$'\n'
        done
    done
    out=$(printf '%s' "$out" | grep . || true)
    if [ -n "$out" ]; then
        printf '%s\n' "$out"
        return 1
    fi
    log "all worktrees are under $ROOT"
}

cmd_prune() {
    local dry=0 dir=.
    while [ $# -gt 0 ]; do
        case "$1" in
        -n | --dry-run) dry=1; shift ;;
        *) dir=$1; shift ;;
        esac
    done
    local repo base prs checked patterns b tip reason n=0 kept=0
    repo=$(main_repo "$dir")
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes -o ConnectTimeout=5" \
        git -C "$repo" fetch --quiet --prune origin 2>/dev/null || log "fetch failed; using local refs"
    base=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) ||
        die "$(repo_name "$repo"): no origin/HEAD (run: git remote set-head origin --auto)"
    prs=""
    if command -v gh >/dev/null 2>&1; then
        prs=$(cd "$repo" && gh pr list --state merged --limit 1000 \
            --json number,headRefName,headRefOid --jq '.[] | "\(.headRefName) \(.headRefOid) \(.number)"' 2>/dev/null) ||
            log "gh unavailable; only checking git ancestry"
    fi
    checked=$(git -C "$repo" worktree list --porcelain | sed -n 's|^branch refs/heads/||p')
    read -r -a patterns <<<"${WORKTREE_PRUNE_PATTERNS:-claude/* codex/* wt/* worktree-*}"

    while IFS= read -r b; do
        [ -n "$b" ] || continue
        if printf '%s\n' "$checked" | grep -qxF "$b"; then continue; fi
        tip=$(git -C "$repo" rev-parse "refs/heads/$b")
        reason=""
        if git -C "$repo" merge-base --is-ancestor "$tip" "$base"; then
            reason="merged into $base"
        else
            local line pr_oid pr_num
            line=$(printf '%s\n' "$prs" | awk -v b="$b" '$1==b' | head -1)
            if [ -n "$line" ]; then
                pr_oid=$(printf '%s' "$line" | cut -d' ' -f2)
                pr_num=$(printf '%s' "$line" | cut -d' ' -f3)
                if [ "$pr_oid" = "$tip" ] ||
                    { git -C "$repo" cat-file -e "$pr_oid^{commit}" 2>/dev/null &&
                        git -C "$repo" merge-base --is-ancestor "$tip" "$pr_oid"; }; then
                    reason="PR #$pr_num merged"
                fi
            fi
            if [ -z "$reason" ] && ! git -C "$repo" cherry "$base" "$tip" | grep -q '^+'; then
                reason="all commits already in $base"
            fi
        fi
        if [ -z "$reason" ]; then
            kept=$((kept + 1))
            continue
        fi
        n=$((n + 1))
        if [ "$dry" -eq 1 ]; then
            printf 'would delete %s (%s) - %s\n' "$b" "${tip:0:9}" "$reason"
        else
            git -C "$repo" branch -D "$b" >/dev/null
            printf 'deleted %s (was %s) - %s\n' "$b" "${tip:0:9}" "$reason"
        fi
    done < <(git -C "$repo" for-each-ref --format='%(refname:short)' "${patterns[@]/#/refs/heads/}")
    log "$(repo_name "$repo"): $n pruned$([ "$dry" -eq 1 ] && echo ' (dry run)'), $kept kept (unmerged work)"
}

json_field() { # json_field <key>  (reads JSON on stdin)
    if command -v jq >/dev/null 2>&1; then
        jq -r --arg k "$1" '.[$k] // empty'
    else
        python3 -c 'import json,sys; print(json.load(sys.stdin).get(sys.argv[1]) or "")' "$1"
    fi
}

cmd_claude_hook() {
    local input
    input=$(cat)
    case "${1:-}" in
    create)
        local name cwd
        name=$(json_field name <<<"$input")
        cwd=$(json_field cwd <<<"$input")
        [ -n "$name" ] || die "hook input has no name"
        WORKTREE_BRANCH_PREFIX="${WORKTREE_BRANCH_PREFIX:-claude}" cmd_add -C "${cwd:-.}" "$name"
        ;;
    remove)
        local path
        path=$(json_field worktree_path <<<"$input")
        [ -n "$path" ] || die "hook input has no worktree_path"
        cmd_rm "$path"
        ;;
    *) die "usage: git wt claude-hook create|remove" ;;
    esac
}

case "${1:-}" in
add) shift; cmd_add "$@" ;;
rm | remove) shift; cmd_rm "$@" ;;
path) shift; [ $# -eq 1 ] || die "usage: git wt path <name>"
    printf '%s\n' "$ROOT/$(repo_name "$(main_repo .)")/$(sanitize "$1")" ;;
ls | list) cmd_ls ;;
doctor) shift; cmd_doctor "$@" ;;
root) printf '%s\n' "$ROOT" ;;
setup) shift; cmd_setup "$@" ;;
seed) shift; cmd_seed "$@" ;;
prune) shift; cmd_prune "$@" ;;
claude-hook) shift; cmd_claude_hook "$@" ;;
"" | -h | --help | help) awk 'NR>1 && /^set -euo/{exit} NR>1' "$0" ;;
*) die "unknown command: $1 (see git wt --help)" ;;
esac
